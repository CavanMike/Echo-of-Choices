<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashbordMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/regsback"
    tools:context=".screen.dashboard.DashboardActivity">



    <TextView
        android:id="@+id/tv_username"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text=""
        android:textColor="#D4AF37"
        android:textSize="18sp"
        android:fontFamily="serif-monospace"
        android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="The town has changed since you left."
            android:textColor="#888888"
            android:textSize="16sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ── START GAME button ── -->
    <Button
        android:id="@+id/btn_start_game"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:text="▶  Begin Your Story"
        android:textColor="#0D1B2E"
        android:textSize="17sp"
        android:textStyle="bold"
        android:fontFamily="serif"
        android:backgroundTint="#D4AF37" />

    <Button
            android:id="@+id/btn_to_profile"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Profile"
            android:backgroundTint="#4A5D6E" />

    <Button
        android:id="@+id/btn_to_charater"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="View Friends"
        android:backgroundTint="#4A5D6E" />

        <Button
            android:id="@+id/btn_logout"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_gravity="center"
            android:text="Leave the Town Again(Logout)"
            android:textColor="#8B0000" />

    </LinearLayout>

