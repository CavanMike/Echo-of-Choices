<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/regsiterMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    android:padding="24dp"
    tools:context=".screen.Register.RegisterActivity">

    <TextView
        android:id="@+id/title_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="60dp"
        android:fontFamily="serif-monospace"
        android:text="Echo of Choices"
        android:textColor="#D4AF37"
        android:textSize="32sp"
        android:textStyle="bold"
        android:shadowColor="#000000"
        android:shadowRadius="5"
        android:shadowDx="2"
        android:shadowDy="2" />

    <TextView
        android:id="@+id/subtitle_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/title_text"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="8dp"
        android:fontFamily="serif"
        android:text="Who are you ?"
        android:textColor="#FFFFFF"
        android:textSize="18sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <EditText
            android:id="@+id/et_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Username"
            android:textColorHint="#BBFFFFFF"
            android:textColor="#FFFFFF"
            android:inputType="text"
            android:backgroundTint="#D4AF37"
            android:padding="12dp" />

        <EditText
            android:id="@+id/et_reg_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Create Password"
            android:textColorHint="#BBFFFFFF"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:backgroundTint="#D4AF37"
            android:padding="12dp" />

        <EditText
            android:id="@+id/et_reg_confirm_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="Re-enter Password"
            android:textColorHint="#BBFFFFFF"
            android:textColor="#FFFFFF"
            android:inputType="textPassword"
            android:backgroundTint="#D4AF37"
            android:padding="12dp" />

        <Button
            android:id="@+id/btn_register"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="32dp"
            android:text="Start your path"
            android:textSize="18sp"
            android:backgroundTint="#D4AF37"
            android:textColor="#1A1A1A" />

    </LinearLayout>

</RelativeLayout>
